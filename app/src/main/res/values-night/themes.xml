<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyPDF" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">#0288D1</item>
        <item name="colorPrimaryVariant">#01579B</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#F57C00</item>
        <item name="colorSecondaryVariant">#E65100</item>
        <item name="colorOnSecondary">#000000</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MyPDF.PdfOpenProxy" parent="Theme.MyPDF">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_manage_page_normal"
    android:orientation="vertical"
    android:padding="7dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="#EEF1F4">

        <ImageView
            android:id="@+id/manage_page_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="页面缩略图"
            android:scaleType="centerInside" />

        <ProgressBar
            android:id="@+id/manage_page_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/manage_page_badge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_manage_selection_badge"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/manage_page_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#202124"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/manage_page_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#70757A"
        android:textSize="11sp" />

</LinearLayout>

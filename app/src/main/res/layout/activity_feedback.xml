<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/feedback_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EAF4FC"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="只有点击“提交反馈”后，表单内容才会通过 FormSubmit 转发至开发者邮箱。不会附带 PDF 或页面内容，也不会在设备上离线排队后静默发送。"
                android:textColor="#263238"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="问题类型（点击选择）"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="?attr/colorPrimary"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/feedback_category"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:textColor="#202124"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="问题描述（必填）"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="?attr/colorPrimary"
                app:counterEnabled="true"
                app:counterMaxLength="4000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feedback_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="4000"
                    android:minHeight="130dp"
                    android:paddingTop="12dp"
                    android:textColor="#202124"
                    android:textColorHint="#7A8086" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="复现步骤（选填）"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="?attr/colorPrimary"
                app:counterEnabled="true"
                app:counterMaxLength="4000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feedback_reproduction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="4000"
                    android:minHeight="105dp"
                    android:paddingTop="12dp"
                    android:textColor="#202124"
                    android:textColorHint="#7A8086" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="联系邮箱（选填）"
                app:boxBackgroundColor="@android:color/white"
                app:boxStrokeColor="?attr/colorPrimary"
                app:helperText="仅用于需要进一步确认问题时联系您。">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/feedback_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:inputType="textEmailAddress"
                    android:maxLength="254"
                    android:textColor="#202124"
                    android:textColorHint="#7A8086" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="自动附带的技术信息"
                android:textColor="#202124"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/feedback_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:textColor="#4F555B"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="不会附带 PDF、文件名、路径、正文、OCR 结果、搜索词、批注、密码、截图、Android ID、广告 ID、IMEI、应用列表或 Logcat。请不要在问题描述中主动粘贴敏感内容。"
                android:textColor="#8A4B00"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/feedback_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/feedback_submit"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="提交反馈"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

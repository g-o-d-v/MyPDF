<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:name="com.nless.mypdf.app.MyPdfApplication"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPDF">

        <activity
            android:name="com.nless.mypdf.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.nless.mypdf.ui.PdfViewerActivity"
            android:theme="@style/Theme.MyPDF" />

        <activity
            android:name="com.nless.mypdf.ui.SettingsActivity"
            android:theme="@style/Theme.MyPDF" />

        <activity
            android:name="com.nless.mypdf.ui.ToolCategoryActivity"
            android:theme="@style/Theme.MyPDF" />

        <activity
            android:name="com.nless.mypdf.feature.create.CreatePdfActivity"
            android:theme="@style/Theme.MyPDF" />

        <activity
            android:name="com.nless.mypdf.feature.export.ExportConvertActivity"
            android:theme="@style/Theme.MyPDF" />

        <activity
            android:name="com.nless.mypdf.feature.manage.ManagePdfPagesActivity"
            android:theme="@style/Theme.MyPDF" />

        <activity
            android:name="com.nless.mypdf.feature.protection.PdfProtectionActivity"
            android:theme="@style/Theme.MyPDF" />

        <service
            android:name="com.nless.mypdf.feature.manage.PdfMergeWorkerService"
            android:exported="false"
            android:process=":pdf_merge"
            android:stopWithTask="true" />

    </application>
</manifest>
